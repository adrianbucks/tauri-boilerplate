{
  "name": "tauri-boilerplate",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform local-first business application platform built with Tauri 2, React, SQLite, and iroh P2P sync",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "build": "turbo run build",
    "build:web": "pnpm --filter @apps/demo build",
    "build:tauri": "pnpm --filter @apps/demo tauri build",
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @apps/demo dev",
    "dev:tauri": "pnpm --filter @apps/demo tauri dev",
    "preview": "pnpm --filter @apps/demo preview",
    "tauri": "pnpm --filter @apps/demo tauri",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:security": "turbo run test:security",
    "test:sync": "turbo run test:sync",
    "clean": "turbo run clean && rimraf node_modules dist apps/demo/dist",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\""
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "prettier": "^3.5.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
