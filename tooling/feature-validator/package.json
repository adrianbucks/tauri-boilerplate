{
  "name": "@tooling/feature-validator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "feature-validator": "./dist/cli.js"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "validate": "tsx src/cli.ts",
    "feature-validate": "tsx src/cli.ts --features ../../features"
  },
  "dependencies": {
    "@platform/core": "workspace:*",
    "@platform/feature-system": "workspace:*",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "tsx": "^4.19.3"
  }
}
